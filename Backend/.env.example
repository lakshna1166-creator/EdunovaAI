# ==============================================================================
# EduNovaAI - Backend Environment Configuration
# Copy this file to .env and fill in your Supabase credentials and JWT secret
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from: https://supabase.com/dashboard -> Project -> Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Service Role Key / Secret Key (bypasses RLS for secure backend operations)
# NOTE: Never expose this key in the frontend client!
SUPABASE_KEY=your_supabase_service_role_secret_key_here
# Legacy alias (still accepted): SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# JWT Authentication Secret
# Used to sign and verify JSON Web Tokens for student authentication
# Generate a strong 64+ char random string (e.g. openssl rand -base64 32)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_edunova_ai_2026_change_this_in_production

# ------------------------------------------------------------------------------
# Frontend Application URL (CORS Whitelist)
# In production, set this to your client URL (e.g. https://app.edunova.ai)
# Multiple origins can be comma-separated: https://app.edunova.ai,https://edunova.ai
# ------------------------------------------------------------------------------
FRONTEND_URL=# ==============================================================================
# EduNovaAI - Backend Environment Configuration
# Copy this file to .env and fill in your Supabase credentials and JWT secret
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from: https://supabase.com/dashboard -> Project -> Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Service Role Key / Secret Key (bypasses RLS for secure backend operations)
# NOTE: Never expose this key in the frontend client!
SUPABASE_KEY=your_supabase_service_role_secret_key_here
# Legacy alias (still accepted): SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# JWT Authentication Secret
# Used to sign and verify JSON Web Tokens for student authentication
# Generate a strong 64+ char random string (e.g. openssl rand -base64 32)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_edunova_ai_2026_change_this_in_production

# ------------------------------------------------------------------------------
# Frontend Application URL (CORS Whitelist)
# In production, set this to your client URL (e.g. https://app.edunova.ai)
# Multiple origins can be comma-separated: https://app.edunova.ai,https://edunova.ai
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Required for password-reset emails)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="EduNovaAI" <your-email@gmail.com>


