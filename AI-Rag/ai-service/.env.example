# EduNovaAI ai-service environment template.
# Copy to .env and fill in real values. NEVER commit .env with secrets.
# Variable names only — no real secret values here.

# --- Gemini (primary LLM with 7-key rotation) ---
# Configure up to 7 Gemini API keys. Empty/missing keys are ignored.
# Key rotation happens transparently inside the application.
# The application works with as few as 1 key.
GEMINI_API_KEY_1=your_key_1
GEMINI_API_KEY_2=your_key_2
GEMINI_API_KEY_3=your_key_3
GEMINI_API_KEY_4=your_key_4
GEMINI_API_KEY_5=your_key_5
GEMINI_API_KEY_6=your_key_6
GEMINI_API_KEY_7=your_key_7
GEMINI_API_KEY_8=your_key_8
GEMINI_API_KEY_9=your_key_9

# Gemini model configuration (optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Retry configuration for 503 errors (optional)
GEMINI_MAX_RETRIES_PER_MODEL=1
GEMINI_RETRY_DELAY_SECONDS=2.0

# --- Supabase (RAG vector store, required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

HUGGING_FACE_AUDIO_key=Hugging_face_API_key
AUDIO_MODEL=your_TTS_model


# --- HeyGen (optional video generation, backend-only) ---
HEYGEN_API_KEY=your_heygen_key
