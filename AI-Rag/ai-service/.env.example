# EduNovaAI ai-service environment template.
# Copy to .env and fill in real values. NEVER commit .env with secrets.
# Variable names only — no real secret values here.

# --- Omni (primary LLM, required) ---
OMNI_API_KEY=
OMNI_API_URL=https://api.cheaperinference.com/v1
# Exact model id from the provider catalog (e.g. gpt-4o-mini). Override as needed.
OMNI_MODEL=gpt-4o-mini

# --- Supabase (RAG vector store, required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# --- Gemini (optional fallback LLM, preserved) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- HeyGen (optional video generation, backend-only) ---
HEYGEN_API_KEY=
