# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables — NEVER commit secrets
.env
.env.*
*.env.local
!.env.example

# IDE / Editor files
.vscode/
.idea/
.DS_Store

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# SentenceTransformer model files (committed to bake into Docker image on Render)
models/*
!models/.gitkeep

# Data / Uploads
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
